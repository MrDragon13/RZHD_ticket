# API-ключ DeepSeek. Хранится только на backend и никогда не передается во frontend.
DEEPSEEK_API_KEY=put_your_deepseek_key_here

# Базовый адрес DeepSeek OpenAI-compatible API.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Модель для смыслового разбора, диалога, объяснений и AI Fact Finder.
DEEPSEEK_MODEL=deepseek-chat

# Таймаут одного обращения к DeepSeek в секундах.
DEEPSEEK_TIMEOUT_SECONDS=20

# URL backend API для frontend при локальной разработке.
VITE_API_BASE_URL=http://localhost:8000
