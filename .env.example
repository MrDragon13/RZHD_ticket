# API-ключ DeepSeek. Хранится только на backend и никогда не передается во frontend.
DEEPSEEK_API_KEY=put_your_deepseek_key_here

# Базовый адрес DeepSeek OpenAI-compatible API.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Модель для смыслового разбора, диалога, объяснений и AI Fact Finder.
DEEPSEEK_MODEL=deepseek-chat

# Таймаут одного обращения к DeepSeek в секундах (понимание запроса, факты; по умолчанию 90).
DEEPSEEK_TIMEOUT_SECONDS=90

# Отдельный таймаут для голосового пояснения рекомендации (тяжёлый JSON по поезду).
DEEPSEEK_EXPLAIN_TIMEOUT_SECONDS=180

# Живой поиск через vendored aiorzd → pass.rzd.ru (включено по умолчанию).
# Отключить только demo JSON: RZD_LIVE_ENABLED=0
# При ошибке или капче при RZD_LIVE_FALLBACK=1 возвращаются demo поезда из JSON.
RZD_LIVE_ENABLED=1
RZD_LIVE_FALLBACK=1

# Слой 5764 (вагоны, полки, схема): по умолчанию НЕ вызывается при поиске — только по
# POST /api/train-carriage-details перед выбором мест. Включить массово при поиске (тяжело):
# RZD_CARRIAGE_ENRICH=1
RZD_CARRIAGE_ENRICH_MAX_TRAINS=15

# Пауза между опросами RID (сек) для поездов 5827 / вагонов 5764; раньше было 1 с до каждого запроса.
# RZD_TRAINS_RID_SLEEP_SEC=0.35
# RZD_CARRIAGE_RID_SLEEP_SEC=0.35

# Параллелизм отложенных basicRoute + carriages (по умолчанию 2; 1 — максимум осторожности с капчей).
# RZD_SECONDARY_CONCURRENCY=2

# BasicRoute при поиске (тяжёло: последовательные запросы к РЖД). По умолчанию выкл.;
# включите явно (1), если нужны остановки сразу на карте без ленивого POST /api/train-route-stops.
# RZD_ROUTE_STOPS_ON_SEARCH=1
RZD_ROUTE_STOPS_MAX_TRAINS=15

# LLM для нарезки сегмента маршрута (индексы станций) — по умолчанию выкл. при наличии basicRoute.
# Включить при отладке: ROUTE_SEGMENT_USE_LLM=1
# ROUTE_SEGMENT_USE_LLM=0

# Уровень логов Python на backend (INFO — видны метки времени search_live в docker logs).
# LOG_LEVEL=INFO

# URL backend API для frontend при локальной разработке.
VITE_API_BASE_URL=http://localhost:8000
