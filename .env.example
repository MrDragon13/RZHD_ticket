# API-ключ DeepSeek. Хранится только на backend и никогда не передается во frontend.
DEEPSEEK_API_KEY=put_your_deepseek_key_here

# Базовый адрес DeepSeek OpenAI-compatible API.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Модель для смыслового разбора, диалога, объяснений и AI Fact Finder.
DEEPSEEK_MODEL=deepseek-chat

# Таймаут одного обращения к DeepSeek в секундах (понимание запроса, факты; по умолчанию 90).
DEEPSEEK_TIMEOUT_SECONDS=90

# Отдельный таймаут для голосового пояснения рекомендации (тяжёлый JSON по поезду).
DEEPSEEK_EXPLAIN_TIMEOUT_SECONDS=180

# Живой поиск через vendored aiorzd → pass.rzd.ru (включено по умолчанию).
# Отключить только demo JSON: RZD_LIVE_ENABLED=0
# При ошибке или капче при RZD_LIVE_FALLBACK=1 возвращаются demo поезда из JSON.
RZD_LIVE_ENABLED=1
RZD_LIVE_FALLBACK=1

# Второй запрос к РЖД (схема вагонов, layer 5764) для полок и вместимости вагонов. Отключить: 0.
# RZD_CARRIAGE_CONCURRENCY — параллельных запросов (по числу поездов в выдаче).
RZD_CARRIAGE_ENRICH=1
RZD_CARRIAGE_CONCURRENCY=4

# Полный список станций по ходу следования (basicRoute на pass.rzd.ru, STRUCTURE_ID=704).
# Нужен для карты и промежуточных остановок; слой поиска поездов (5827) их не содержит.
RZD_ROUTE_STOPS_ENRICH=1

# URL backend API для frontend при локальной разработке.
VITE_API_BASE_URL=http://localhost:8000
